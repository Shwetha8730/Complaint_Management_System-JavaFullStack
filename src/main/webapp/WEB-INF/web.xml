<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>controller.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/LoginServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AddComplaintServlet</servlet-name>
        <servlet-class>controller.AddComplaintServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AddComplaintServlet</servlet-name>
        <url-pattern>/AddComplaintServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ViewComplaintServlet</servlet-name>
        <servlet-class>controller.ViewComplaintServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ViewComplaintServlet</servlet-name>
        <url-pattern>/ViewComplaintServlet</url-pattern>
    </servlet-mapping>
    <servlet>
    <servlet-name>UpdateStatusServlet</servlet-name>
    <servlet-class>controller.UpdateStatusServlet</servlet-class>
    </servlet>
    <servlet-mapping>
    <servlet-name>UpdateStatusServlet</servlet-name>
    <url-pattern>/UpdateStatusServlet</url-pattern>
    </servlet-mapping>
    <servlet>
    <servlet-name>DeleteComplaintServlet</servlet-name>
    <servlet-class>controller.DeleteComplaintServlet</servlet-class>
</servlet>
<servlet-mapping>
    <servlet-name>DeleteComplaintServlet</servlet-name>
    <url-pattern>/DeleteComplaintServlet</url-pattern>
</servlet-mapping>
<servlet>
    <servlet-name>LogoutServlet</servlet-name>
    <servlet-class>controller.LogoutServlet</servlet-class>
</servlet>
<servlet-mapping>
    <servlet-name>LogoutServlet</servlet-name>
    <url-pattern>/LogoutServlet</url-pattern>
</servlet-mapping>
<servlet>
    <servlet-name>UpdateRemarkServlet</servlet-name>
    <servlet-class>controller.UpdateRemarkServlet</servlet-class>
</servlet>
<servlet-mapping>
    <servlet-name>UpdateRemarkServlet</servlet-name>
    <url-pattern>/UpdateRemarkServlet</url-pattern>
</servlet-mapping>
</web-app>